<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neumorph_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="40dp">

        <!-- ── Toolbar ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp">
            
            <ImageView
                android:id="@+id/btnBackRecipient"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_neumorph_card_sm"
                android:src="@drawable/ic_chevron_left"
                android:padding="12dp"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Send Invitation"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Recipient Filter" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginBottom="16dp" />

        <!-- Filter Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neumorph_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Filter Recipients" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp" android:layout_marginBottom="12dp" />

            <!-- Year Flow -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Year" android:textColor="@color/text_secondary" android:textSize="14sp" android:layout_marginBottom="8dp" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp"
                android:layout_marginBottom="16dp">
                <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sem 1" style="@style/Widget.MaterialComponents.Chip.Choice"/>
                <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sem 2" style="@style/Widget.MaterialComponents.Chip.Choice"/>
                <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sem 3" style="@style/Widget.MaterialComponents.Chip.Choice" android:id="@+id/chipSem3"/>
                <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sem 4" style="@style/Widget.MaterialComponents.Chip.Choice"/>
                <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sem 5" style="@style/Widget.MaterialComponents.Chip.Choice"/>
                <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sem 6" style="@style/Widget.MaterialComponents.Chip.Choice"/>
            </com.google.android.material.chip.ChipGroup>

            <!-- Dept Flow -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Department" android:textColor="@color/text_secondary" android:textSize="14sp" android:layout_marginBottom="8dp" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupDept"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                android:layout_marginBottom="16dp">
                <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BCA" style="@style/Widget.MaterialComponents.Chip.Choice" android:id="@+id/chipBca"/>
                <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BSc" style="@style/Widget.MaterialComponents.Chip.Choice"/>
            </com.google.android.material.chip.ChipGroup>

            <!-- Section Flow -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Section" android:textColor="@color/text_secondary" android:textSize="14sp" android:layout_marginBottom="8dp" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                android:layout_marginBottom="16dp">
                <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A" style="@style/Widget.MaterialComponents.Chip.Choice"/>
                <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="B" style="@style/Widget.MaterialComponents.Chip.Choice" android:id="@+id/chipSecB"/>
                <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="All" style="@style/Widget.MaterialComponents.Chip.Choice"/>
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/tvSelectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selected: 48 students"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:background="@drawable/bg_pill_active"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp" />

        </LinearLayout>

        <!-- Quick Select Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neumorph_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="32dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Quick Select" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp" android:layout_marginBottom="4dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Presets" android:textColor="@color/text_secondary" android:textSize="14sp" android:layout_marginBottom="12dp" />

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp">
                <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="All BCA" style="@style/Widget.MaterialComponents.Chip.Choice"/>
                <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sports Team" style="@style/Widget.MaterialComponents.Chip.Choice"/>
                <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Honor Roll" style="@style/Widget.MaterialComponents.Chip.Choice"/>
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <Button
            android:id="@+id/btnSubmitTournament"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Create Tournament &amp; Notify"
            style="@style/ProCollegia.Button.Primary" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
