<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="40dp">

        <!-- ─── Gauge Card ─── -->
        <LinearLayout
            android:id="@+id/llGaugeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neumorph_card"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="20dp"
            android:layout_marginTop="8dp">

            <!-- Shimmer overlay while loading -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerGauge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <View
                        android:layout_width="220dp"
                        android:layout_height="120dp"
                        android:background="@color/neumorph_bg_dark" />

                    <View
                        android:layout_width="80dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/neumorph_bg_dark" />

                    <View
                        android:layout_width="120dp"
                        android:layout_height="36dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/neumorph_bg_dark" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- Real content (hidden until loaded) -->
            <LinearLayout
                android:id="@+id/llGaugeContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <com.procollegia.views.GaugeView
                    android:id="@+id/gaugeView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp" />

                <TextView
                    android:id="@+id/tvHonorScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="52sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvTierBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★  GOLD TIER"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_tier_gold"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="8dp"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </LinearLayout>

        <!-- ─── 6-Month History Card ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neumorph_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6-Month History"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/lineChart"
                android:layout_width="match_parent"
                android:layout_height="180dp" />

        </LinearLayout>

        <!-- ─── Recent Events Card ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neumorph_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recent Events"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Shimmer for events -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View android:layout_width="match_parent" android:layout_height="40dp"
                        android:background="@color/neumorph_bg_dark" android:layout_marginBottom="10dp"/>
                    <View android:layout_width="match_parent" android:layout_height="40dp"
                        android:background="@color/neumorph_bg_dark" android:layout_marginBottom="10dp"/>
                    <View android:layout_width="match_parent" android:layout_height="40dp"
                        android:background="@color/neumorph_bg_dark" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
