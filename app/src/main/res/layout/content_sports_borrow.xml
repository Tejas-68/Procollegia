<?xml version="1.0" encoding="utf-8"?>
<!-- content_sports_borrow.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Search bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_neumorph_input"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:paddingHorizontal="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:hint="Search equipment..."
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:background="@null"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Shimmer loading -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerEquipment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp">
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
            <View android:layout_width="match_parent" android:layout_height="110dp"
                android:background="@drawable/bg_neumorph_card_sm" android:layout_marginBottom="12dp"/>
            <View android:layout_width="match_parent" android:layout_height="110dp"
                android:background="@drawable/bg_neumorph_card_sm" android:layout_marginBottom="12dp"/>
            <View android:layout_width="match_parent" android:layout_height="110dp"
                android:background="@drawable/bg_neumorph_card_sm"/>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <!-- Equipment list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEquipment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:visibility="gone" />

</LinearLayout>
