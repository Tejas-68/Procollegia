<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="12dp"
    android:gravity="top">

    <!-- Colored left accent bar -->
    <View
        android:id="@+id/viewAccent"
        android:layout_width="4dp"
        android:layout_height="60dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_pill_active" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Time -->
        <TextView
            android:id="@+id/tvPeriodTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:00 – 09:00"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Subject -->
        <TextView
            android:id="@+id/tvPeriodName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Data Structures"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <!-- Room + Teacher row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvPeriodRoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room 204"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_alignParentStart="true" />

            <TextView
                android:id="@+id/tvPeriodTeacher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prof. Sharma"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>

    </LinearLayout>

</LinearLayout>
