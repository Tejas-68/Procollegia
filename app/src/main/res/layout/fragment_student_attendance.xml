<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neumorph_bg"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="100dp">

        <!-- Header Area -->
        <LinearLayout
            android:id="@+id/llHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="16dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Attendance"
                android:textAlignment="center"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <ImageView
                android:id="@+id/ivFilter"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_neumorph_circle"
                android:src="@drawable/ic_filter"
                android:padding="12dp"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <!-- Overall Attendance Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clOverall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_neumorph_card"
            android:padding="24dp"
            app:layout_constraintTop_toBottomOf="@id/llHeader">

            <TextView
                android:id="@+id/tvOverallTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Overall Attendance"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressAttendance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:progress="78"
                app:indicatorColor="@color/accent_green"
                app:trackColor="@color/accent_red"
                app:indicatorSize="160dp"
                app:trackThickness="18dp"
                app:indicatorDirectionCircular="clockwise"
                app:trackCornerRadius="9dp"
                app:layout_constraintTop_toBottomOf="@id/tvOverallTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvAttendancePercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="78%"
                android:textColor="@color/text_primary"
                android:textSize="40sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/progressAttendance"
                app:layout_constraintBottom_toBottomOf="@id/progressAttendance"
                app:layout_constraintStart_toStartOf="@id/progressAttendance"
                app:layout_constraintEnd_toEndOf="@id/progressAttendance" />

            <TextView
                android:id="@+id/tvStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Present: 156 | Absent: 44"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/progressAttendance"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Calendar Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_neumorph_card"
            android:padding="20dp"
            app:layout_constraintTop_toBottomOf="@id/clOverall">

            <ImageView
                android:id="@+id/ivPrevMonth"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_chevron_left"
                android:padding="4dp"
                app:tint="@color/text_primary"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintTop_toTopOf="@id/tvMonthYear"
                app:layout_constraintBottom_toBottomOf="@id/tvMonthYear"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvMonthYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="February 2026"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageView
                android:id="@+id/ivNextMonth"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_chevron_right"
                android:padding="4dp"
                app:tint="@color/text_primary"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintTop_toTopOf="@id/tvMonthYear"
                app:layout_constraintBottom_toBottomOf="@id/tvMonthYear"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/llDaysHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:weightSum="7"
                app:layout_constraintTop_toBottomOf="@id/tvMonthYear">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Su" android:textAlignment="center" android:textColor="@color/text_secondary" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mo" android:textAlignment="center" android:textColor="@color/text_secondary" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tu" android:textAlignment="center" android:textColor="@color/text_secondary" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="We" android:textAlignment="center" android:textColor="@color/text_secondary" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Th" android:textAlignment="center" android:textColor="@color/text_secondary" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Fr" android:textAlignment="center" android:textColor="@color/text_secondary" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Sa" android:textAlignment="center" android:textColor="@color/text_secondary" android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCalendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:overScrollMode="never"
                app:layout_constraintTop_toBottomOf="@id/llDaysHeader" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Subject Breakdown Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clSubjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_neumorph_card"
            android:padding="20dp"
            app:layout_constraintTop_toBottomOf="@id/clCalendar">

            <TextView
                android:id="@+id/tvSubjectsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subject Breakdown"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout
                android:id="@+id/llSubjectsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/tvSubjectsTitle" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <Button
            android:id="@+id/btnRequestLeave"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/accent_blue"
            android:text="Request Leave"
            android:textColor="@color/text_on_accent"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/clSubjects" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
