<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neumorph_bg"
    android:orientation="vertical"
    android:paddingHorizontal="20dp">

    <!-- Year selector chips -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="10dp"
        android:text="Select Year"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/chipYear1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_active"
            android:gravity="center"
            android:text="Year 1"
            android:textColor="@color/text_on_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipYear2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_pill_inactive"
            android:gravity="center"
            android:text="Year 2"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipYear3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_inactive"
            android:gravity="center"
            android:text="Year 3"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Info label -->
    <TextView
        android:id="@+id/tvSubjectInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Subjects for Year 1"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Add subject row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/etNewSubject"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_neumorph_input"
            android:hint="Enter subject name..."
            android:paddingHorizontal="14dp"
            android:textSize="14sp"
            android:maxLines="1"
            android:inputType="textCapWords"
            android:imeOptions="actionDone" />

        <Button
            android:id="@+id/btnAddSubject"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="Add"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/accent_blue"
            app:cornerRadius="12dp"
            android:paddingHorizontal="20dp" />

    </LinearLayout>

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/pbSubjects"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="40dp"
        android:text="No subjects added yet.\nTap Add to create your first subject."
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Subject list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSubjects"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />

</LinearLayout>
