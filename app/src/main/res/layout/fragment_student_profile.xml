<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neumorph_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="100dp">

        <!-- ── Gradient Header Card ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_profile_header"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="48dp"
            android:paddingBottom="32dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp">

            <!-- Avatar circle -->
            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_avatar_ring"
                    android:src="@drawable/ic_person"
                    android:padding="20dp"
                    android:tint="#FFFFFF"
                    android:scaleType="centerInside" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Name"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="student@college.edu"
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <!-- Quick stats row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvStatSem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4th"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Semester"
                        android:textColor="#BBFFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="36dp"
                    android:background="#44FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvStatAttendance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="82%"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Attendance"
                        android:textColor="#BBFFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="36dp"
                    android:background="#44FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvStatHonor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="720"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Honor Score"
                        android:textColor="#BBFFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- ── Academic Info Card ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Academic Info"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="24dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neumorph_card"
            android:orientation="vertical"
            android:layout_marginHorizontal="24dp">

            <!-- Row: Roll No -->
            <LinearLayout android:id="@+id/rowRoll"
                style="@style/ProfileRow">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🎓" android:textSize="18sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Roll Number"
                    android:textColor="@color/text_secondary" android:textSize="14sp"
                    android:layout_marginStart="14dp"/>
                <TextView android:id="@+id/tvRollNo"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="21CS045"
                    android:textColor="@color/text_primary" android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider" android:layout_marginHorizontal="16dp"/>

            <!-- Row: Department -->
            <LinearLayout android:id="@+id/rowDept"
                style="@style/ProfileRow">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🏛️" android:textSize="18sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Department"
                    android:textColor="@color/text_secondary" android:textSize="14sp"
                    android:layout_marginStart="14dp"/>
                <TextView android:id="@+id/tvDept"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Computer Science"
                    android:textColor="@color/text_primary" android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider" android:layout_marginHorizontal="16dp"/>

            <!-- Row: Semester -->
            <LinearLayout android:id="@+id/rowSem"
                style="@style/ProfileRow">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Date:" android:textSize="18sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Semester"
                    android:textColor="@color/text_secondary" android:textSize="14sp"
                    android:layout_marginStart="14dp"/>
                <TextView android:id="@+id/tvSemester"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="4th Semester"
                    android:textColor="@color/text_primary" android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider" android:layout_marginHorizontal="16dp"/>

            <!-- Row: Section -->
            <LinearLayout android:id="@+id/rowSection"
                style="@style/ProfileRow">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="👥" android:textSize="18sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Section"
                    android:textColor="@color/text_secondary" android:textSize="14sp"
                    android:layout_marginStart="14dp"/>
                <TextView android:id="@+id/tvSection"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Section A"
                    android:textColor="@color/text_primary" android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ── Contact Info Card ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contact"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neumorph_card"
            android:orientation="vertical"
            android:layout_marginHorizontal="24dp">

            <LinearLayout android:id="@+id/rowPhone"
                style="@style/ProfileRow">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📱" android:textSize="18sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Phone"
                    android:textColor="@color/text_secondary" android:textSize="14sp"
                    android:layout_marginStart="14dp"/>
                <TextView android:id="@+id/tvPhone"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="+91 98765 43210"
                    android:textColor="@color/text_primary" android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider" android:layout_marginHorizontal="16dp"/>

            <LinearLayout android:id="@+id/rowParent"
                style="@style/ProfileRow">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="👨‍👩‍👦" android:textSize="18sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Parent Phone"
                    android:textColor="@color/text_secondary" android:textSize="14sp"
                    android:layout_marginStart="14dp"/>
                <TextView android:id="@+id/tvParentPhone"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="+91 98765 00000"
                    android:textColor="@color/text_primary" android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ── Settings Card ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neumorph_card"
            android:orientation="vertical"
            android:layout_marginHorizontal="24dp">

            <!-- Notifications toggle row -->
            <LinearLayout
                android:id="@+id/rowNotifications"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔔" android:textSize="18sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Notifications"
                    android:textColor="@color/text_secondary" android:textSize="14sp"
                    android:layout_marginStart="14dp"/>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider" android:layout_marginHorizontal="16dp"/>

            <!-- App Theme toggle row -->
            <LinearLayout
                android:id="@+id/rowDarkMode"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🎨" android:textSize="18sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="App Theme"
                    android:textColor="@color/text_secondary" android:textSize="14sp"
                    android:layout_marginStart="14dp"/>
                <TextView android:id="@+id/tvCurrentTheme"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="System" android:textSize="14sp" android:textColor="@color/text_primary"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider" android:layout_marginHorizontal="16dp"/>

            <!-- Change Password row -->
            <LinearLayout
                android:id="@+id/rowChangePassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔒" android:textSize="18sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Change Password"
                    android:textColor="@color/text_secondary" android:textSize="14sp"
                    android:layout_marginStart="14dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="22sp" android:textColor="@color/text_muted"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider" android:layout_marginHorizontal="16dp"/>

            <!-- About row -->
            <LinearLayout
                android:id="@+id/rowAbout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ℹ️" android:textSize="18sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="About ProCollegia"
                    android:textColor="@color/text_secondary" android:textSize="14sp"
                    android:layout_marginStart="14dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="22sp" android:textColor="@color/text_muted"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ── Logout Button ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="24dp">

            <TextView
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="24dp"
                android:gravity="center"
                android:text="Sign Out"
                android:textColor="@color/accent_red"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_neumorph_card" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ProCollegia v1.0"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="16dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
