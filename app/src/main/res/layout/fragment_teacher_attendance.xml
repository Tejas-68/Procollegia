<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neumorph_bg">

    <!-- ══════════════════════════════════════════════
         Collapsing header — scrolls away with the list
         ══════════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarAttendance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/neumorph_bg"
        android:elevation="0dp"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/rvStudentAttendance">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap">

            <!-- ── Title row ── -->
            <LinearLayout
                android:id="@+id/llHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Attendance"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/btnExportExcel"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_neumorph_card_sm"
                    android:gravity="center"
                    android:paddingHorizontal="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Export PDF"
                        android:textColor="@color/accent_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Period spinner ── -->
            <FrameLayout
                android:id="@+id/flPeriod"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_neumorph_card_sm">
                <Spinner
                    android:id="@+id/spinnerPeriod"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="12dp"
                    android:background="@null" />
            </FrameLayout>

            <!-- ── Year + Section row ── -->
            <LinearLayout
                android:id="@+id/llFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingBottom="8dp"
                android:weightSum="2">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_neumorph_card_sm">
                    <Spinner
                        android:id="@+id/spinnerYear"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_neumorph_card_sm">
                    <Spinner
                        android:id="@+id/spinnerSection"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null" />
                </FrameLayout>
            </LinearLayout>

            <!-- ── Select All + Search row ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical"
                android:weightSum="10">

                <!-- Search bar (takes most of the space) -->
                <EditText
                    android:id="@+id/etSearchStudent"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="6"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_neumorph_card_sm"
                    android:hint="Search..."
                    android:paddingHorizontal="14dp"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:inputType="text" />

                <!-- Select All / Deselect All button -->
                <LinearLayout
                    android:id="@+id/btnSelectAll"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="4"
                    android:background="@drawable/bg_neumorph_card_sm"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSelectAllLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select All"
                        android:textColor="@color/accent_blue"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvSelectAllSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(Present)"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── 5 PM / Cooldown Banner (inside scrollable header) ── -->
            <TextView
                android:id="@+id/tvBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_neumorph_card_sm"
                android:padding="10dp"
                android:textAlignment="center"
                android:textColor="@color/accent_red"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:text="" />

            <!-- reuse llBanner as invisible anchor for banner state -->
            <LinearLayout
                android:id="@+id/llBanner"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"/>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ══════════════════════════════════════
         Main scrollable content area
         ══════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Cooldown timer (shown below header when collapsed) -->
            <TextView
                android:id="@+id/tvCooldown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:paddingVertical="6dp"
                android:text=""
                android:textColor="@color/accent_orange"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- The actual RecyclerView (inside NestedScrollView for collapsing to work) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStudentAttendance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingBottom="200dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══════════════════════════════════════
         Fixed bottom footer (always visible)
         ══════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/llFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/neumorph_bg"
        android:elevation="12dp"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvAttendanceSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Present: 0 | Absent: 0"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnSubmitAttendance"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Submit Attendance"
            style="@style/ProCollegia.Button.Primary" />
    </LinearLayout>

    <!-- Camera FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCameraScanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="100dp"
        android:src="@drawable/ic_camera"
        app:tint="@color/text_on_accent"
        app:backgroundTint="@color/accent_blue" />

    <!-- Centered progress bar -->
    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
