<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_neumorph_card"
    android:orientation="vertical"
    android:padding="16dp"
    android:animateLayoutChanges="true">

    <!-- Header / Visible Area -->
    <LinearLayout
        android:id="@+id/llHeaderArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_neumorph_circle"
            android:src="@drawable/ic_nav_profile"
            android:padding="12dp"
            app:tint="@color/accent_blue" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tvStaffName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prof. Sharma"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubjectCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 Subjects Assigned"
                android:textColor="@color/accent_blue"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivExpandIndicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_nav_home"
            android:rotation="180"
            app:tint="@color/text_muted" />
    </LinearLayout>

    <!-- Expanded Area -->
    <LinearLayout
        android:id="@+id/llExpandedArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="16dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/neumorph_shadow_light"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Assigned Subjects"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:layout_marginBottom="8dp" />

        <!-- Dynamic list of subjects goes here -->
        <LinearLayout
            android:id="@+id/llSubjectsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical">
            
            <EditText
                android:id="@+id/etNewSubject"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_neumorph_card_sm"
                android:hint="New Subject Name"
                android:textSize="12sp"
                android:paddingHorizontal="12dp"
                android:maxLines="1"
                android:inputType="text" />

            <Button
                android:id="@+id/btnAddSubject"
                style="@style/ProCollegia.Button.Outline.Small"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="Add"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
