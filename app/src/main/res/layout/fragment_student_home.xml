<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neumorph_bg"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="100dp">

    <!-- Header Area -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivProfile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_neumorph_circle"
            android:src="@drawable/ic_person"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvRole"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Dashboard"
            android:textAlignment="center"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <ImageView
            android:id="@+id/ivNotifications"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_neumorph_circle"
            android:src="@drawable/ic_notifications"
            android:padding="12dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvGreeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome back,"
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/llHeader"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Alumni Warning Banner -->
    <LinearLayout
        android:id="@+id/llAlumniWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_neumorph_card"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvGreeting">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Action Required: Alumni Status"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/accent_red"/>
            
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="You have been moved to Alumni status. Your data will be deleted from the database in 30 days. Please download your data."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp"/>
            
        <Button
            android:id="@+id/btnDownloadAlumniData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Download Data (Excel)"
            android:backgroundTint="@color/accent_orange"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <!-- Internals Banner -->
    <LinearLayout
        android:id="@+id/llInternalsBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_neumorph_card"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvGreeting">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_nav_academics"
            android:background="@drawable/bg_neumorph_circle"
            android:padding="8dp"
            app:tint="@color/accent_blue" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Internals Ongoing!"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap here to download Timetable"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Timetable Image -->
    <include
        android:id="@+id/includeTimetable"
        layout="@layout/widget_timetable_viewer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/llInternalsBanner"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/llCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:weightSum="2"
        app:layout_constraintTop_toBottomOf="@id/includeTimetable">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clAttendanceCard"
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_neumorph_card">
            
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressAttendance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:progress="78"
                app:indicatorColor="@color/accent_green"
                app:trackColor="@color/neumorph_bg_dark"
                app:indicatorSize="95dp"
                app:trackThickness="10dp"
                app:indicatorDirectionCircular="clockwise"
                app:trackCornerRadius="5dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tvCardAttendance"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/tvAttendancePercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="0%"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/tvOverallText"
                app:layout_constraintEnd_toEndOf="@id/progressAttendance"
                app:layout_constraintHorizontal_bias="0.508"
                app:layout_constraintStart_toStartOf="@id/progressAttendance"
                app:layout_constraintTop_toTopOf="@id/progressAttendance"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/tvOverallText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:layout_marginBottom="-12dp"
                android:text="Overall"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@id/progressAttendance"
                app:layout_constraintEnd_toEndOf="@id/progressAttendance"
                app:layout_constraintStart_toStartOf="@id/progressAttendance"
                app:layout_constraintTop_toBottomOf="@id/tvAttendancePercent" />

            <TextView
                android:id="@+id/tvCardAttendance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="Attendance"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/progressAttendance"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_neumorph_card">
            
            <ImageView
                android:id="@+id/ivHonorScore"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_star" 
                android:background="@drawable/bg_neumorph_circle"
                android:padding="16dp"
                app:tint="@color/accent_gold"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tvHonorScoreValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/tvHonorScoreValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 PTS"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/ivHonorScore"
                app:layout_constraintBottom_toTopOf="@id/tvHonorTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
                
            <TextView
                android:id="@+id/tvHonorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Honor Score"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/tvHonorScoreValue"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

        <!-- High Priority Announcements -->
        <TextView
            android:id="@+id/tvAnnouncementsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Announcements"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/llCards"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/llAnnouncementCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_neumorph_card"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvAnnouncementsLabel">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_warning"
                android:background="@drawable/bg_neumorph_circle"
                android:padding="8dp"
                app:tint="@color/accent_red" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Urgent: Fee Deadline"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_red"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Last date to pay sem fees is Mar 20"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvNoAnnouncements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No announcements right now."
                android:textAlignment="center"
                android:textColor="@color/text_muted"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="24dp"
                android:padding="16dp"
                android:background="@drawable/bg_neumorph_card"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/llAnnouncementCard" />

        <!-- Current Tournament -->
        <TextView
            android:id="@+id/tvTournamentLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tournaments"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/tvNoAnnouncements"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/llCurrentTournament"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_neumorph_card"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvTournamentLabel">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_trophy"
                android:background="@drawable/bg_neumorph_circle"
                android:padding="8dp"
                app:tint="@color/accent_blue" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Currently Ongoing"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_blue"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Inter-College Football"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Finals: Tomorrow @ 4 PM"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Upcoming Tournament -->
        <LinearLayout
            android:id="@+id/llUpcomingTournament"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_neumorph_card"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/llCurrentTournament">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_trophy"
                android:background="@drawable/bg_neumorph_circle"
                android:padding="8dp"
                app:tint="@color/text_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Upcoming"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_muted"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Basketball Championship"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Registrations open on Mar 25"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvNoTournaments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No upcoming tournaments."
            android:textAlignment="center"
            android:textColor="@color/text_muted"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="24dp"
            android:padding="16dp"
            android:background="@drawable/bg_neumorph_card"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/llUpcomingTournament" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
