<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/bg_neumorph_card"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvEquipName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Cricket Bat"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEquipStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill_active"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        android:text="Available"
        android:textColor="@color/text_on_accent"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvQuantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Qty: 12"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:layout_marginTop="4dp" />

    <!-- Action Button (Add Qty) -->
    <TextView
        android:id="@+id/btnIncreaseQty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="+ Add Stk"
        android:textColor="@color/accent_blue"
        android:textSize="13sp"
        android:textStyle="bold"
        android:padding="4dp" />

</LinearLayout>
