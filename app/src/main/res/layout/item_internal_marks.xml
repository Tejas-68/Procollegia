<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/neumorph_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvStudentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <TextView
            android:id="@+id/tvUucmsId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UUCMS ID"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4">

            <EditText
                android:id="@+id/etIa1"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:hint="IA1 /25"
                android:inputType="number"
                android:textSize="12sp"
                android:background="@drawable/bg_neumorph_input"
                android:layout_marginEnd="4dp"
                android:gravity="center"/>

            <EditText
                android:id="@+id/etIa2"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:hint="IA2 /25"
                android:inputType="number"
                android:textSize="12sp"
                android:background="@drawable/bg_neumorph_input"
                android:layout_marginEnd="4dp"
                android:gravity="center"/>

            <EditText
                android:id="@+id/etAssign"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:hint="Assign /10"
                android:inputType="number"
                android:textSize="12sp"
                android:background="@drawable/bg_neumorph_input"
                android:layout_marginEnd="4dp"
                android:gravity="center"/>

            <EditText
                android:id="@+id/etAttend"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:hint="Atten /10"
                android:inputType="number"
                android:textSize="12sp"
                android:background="@drawable/bg_neumorph_input"
                android:gravity="center"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveMarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Marks"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/accent_blue"
            android:textColor="@android:color/white"
            app:cornerRadius="8dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
