<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_neumorph_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Student header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStudentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvUucmsId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UUCMS ID"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Total badge -->
        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_neumorph_circle"
            android:gravity="center"
            android:text="0/60"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/accent_blue" />
    </LinearLayout>

    <!-- Labels row (3 columns) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvLabelIa1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="IA-1\n(/25)"
            android:textSize="10sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:id="@+id/tvLabelIa2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="IA-2\n(/25)"
            android:textSize="10sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:id="@+id/tvLabelAssign"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Assign\n(/10)"
            android:textSize="10sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Input fields (3 columns, no attendance) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/etIa1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:hint="0"
            android:inputType="number"
            android:textSize="14sp"
            android:background="@drawable/bg_neumorph_input"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:maxLength="2" />

        <EditText
            android:id="@+id/etIa2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:hint="0"
            android:inputType="number"
            android:textSize="14sp"
            android:background="@drawable/bg_neumorph_input"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:maxLength="2" />

        <EditText
            android:id="@+id/etAssign"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:hint="0"
            android:inputType="number"
            android:textSize="14sp"
            android:background="@drawable/bg_neumorph_input"
            android:gravity="center"
            android:maxLength="2" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSaveMarks"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Save Marks"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:backgroundTint="@color/accent_blue"
        android:textColor="@android:color/white"
        app:cornerRadius="10dp" />

</LinearLayout>
