<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Section header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvTimetableLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Timetable"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvTimetableUploaded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Timetable image card (zoomable) -->
    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/ivTimetableImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="400dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:background="@drawable/bg_neumorph_card"
        android:padding="8dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="Class Timetable" />

    <!-- Empty/loading state -->
    <LinearLayout
        android:id="@+id/llTimetableEmpty"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/bg_neumorph_card"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No timetable uploaded for today yet"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check back soon or ask your teacher to upload"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</LinearLayout>
