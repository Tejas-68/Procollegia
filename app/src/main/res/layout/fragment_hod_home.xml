<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neumorph_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="100dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="24dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dept. Command Center"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1" />
                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome Back, HOD"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <ImageView
                android:id="@+id/ivProfile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_neumorph_circle"
                android:src="@drawable/ic_person"
                android:padding="12dp" />
        </LinearLayout>

        <!-- Timetable Image -->
        <include
            android:id="@+id/includeTimetable"
            layout="@layout/widget_timetable_viewer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp" />

        <!-- ── Big Analysis Cards (Vertical) ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Attendance Analytics"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <Spinner
                android:id="@+id/spYearAttendance"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_neumorph_card_sm"
                android:layout_marginEnd="8dp" />
            <Spinner
                android:id="@+id/spSectionAttendance"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_neumorph_card_sm" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neumorph_card"
            android:padding="24dp"
            android:layout_marginBottom="28dp">
            
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressAttendanceAnalytics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:progress="0"
                app:indicatorColor="@color/accent_green"
                app:trackColor="@color/accent_red"
                app:indicatorSize="120dp"
                app:trackThickness="12dp"
                app:indicatorDirectionCircular="clockwise"
                app:trackCornerRadius="6dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvAttendancePercentAnalytics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--%"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/progressAttendanceAnalytics"
                app:layout_constraintBottom_toBottomOf="@id/progressAttendanceAnalytics"
                app:layout_constraintStart_toStartOf="@id/progressAttendanceAnalytics"
                app:layout_constraintEnd_toEndOf="@id/progressAttendanceAnalytics" />

            <TextView
                android:id="@+id/tvAttendanceSubtitleAnalytics"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Department Average Attendance"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textAlignment="center"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/progressAttendanceAnalytics"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ── Internals Analysis ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Internal Marks Analytics"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <Spinner
                android:id="@+id/spYearInternals"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_neumorph_card_sm"
                android:layout_marginEnd="8dp" />
            <Spinner
                android:id="@+id/spSectionInternals"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_neumorph_card_sm" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neumorph_card"
            android:padding="24dp"
            android:layout_marginBottom="28dp">
            
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressInternalsAnalytics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:progress="0"
                app:indicatorColor="@color/accent_blue"
                app:trackColor="@color/neumorph_bg_dark"
                app:indicatorSize="120dp"
                app:trackThickness="12dp"
                app:indicatorDirectionCircular="clockwise"
                app:trackCornerRadius="6dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvInternalsPercentAnalytics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--%"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/progressInternalsAnalytics"
                app:layout_constraintBottom_toBottomOf="@id/progressInternalsAnalytics"
                app:layout_constraintStart_toStartOf="@id/progressInternalsAnalytics"
                app:layout_constraintEnd_toEndOf="@id/progressInternalsAnalytics" />

            <TextView
                android:id="@+id/tvInternalsSubtitleAnalytics"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Department Average Internal Marks"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textAlignment="center"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/progressInternalsAnalytics"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Quick Actions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Actions"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="28dp">
            <Button
                android:id="@+id/btnUploadTimetable"
                style="@style/ProCollegia.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Upload Dept. Timetable"
                android:layout_marginBottom="12dp" />
            <Button
                android:id="@+id/btnAssignSubjects"
                style="@style/ProCollegia.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Assign Subjects"
                android:layout_marginBottom="12dp" />
            <Button
                android:id="@+id/btnManageInternals"
                style="@style/ProCollegia.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Manage Internals"
                android:layout_marginBottom="12dp" />
            <Button
                android:id="@+id/btnExportExcel"
                style="@style/ProCollegia.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Export Analytics (Excel)" />
        </LinearLayout>

        <!-- Ongoing Tournaments -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dept. Highlights"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tournaments ›"
                android:textColor="@color/accent_blue"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHighlights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
