<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neumorph_bg"
    android:clipToPadding="false"
    android:paddingBottom="100dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Semester Promotion"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neumorph_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upgrade Semester for All Students"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6th Semester students will become Alumni and their data will be slated for deletion in 30 days."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnUpgradeSemester"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Promote Students"
                android:backgroundTint="@color/accent_blue"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnUndoPromotion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Undo Promotion (Within 24h)"
                android:backgroundTint="@color/accent_red"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Declare Holidays"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neumorph_card"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/btnAddHoliday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Holiday"
                android:backgroundTint="@color/accent_green"
                android:layout_marginBottom="16dp" />

            <!-- We will populate this list programmatically -->
            <LinearLayout
                android:id="@+id/llHolidaysList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
