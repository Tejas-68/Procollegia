<?xml version="1.0" encoding="utf-8"?>
<!-- My Borrowed item row: shows status and Return button if still borrowed -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_neumorph_card_sm"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/tvBorrowedEmoji"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:textSize="22sp"
        android:background="@drawable/bg_neumorph_circle"
        android:text="" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/tvBorrowedName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cricket Bat"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/tvBorrowedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Borrowed: Mar 18"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Status badge -->
        <TextView
            android:id="@+id/tvBorrowedStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/accent_green"
            android:background="@drawable/bg_badge_green"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Return button (hidden when return requested/approved) -->
    <TextView
        android:id="@+id/btnReturn"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Return"
        android:gravity="center"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/accent_blue"
        android:paddingHorizontal="14dp"
        android:background="@drawable/bg_pill_inactive" />

</LinearLayout>
