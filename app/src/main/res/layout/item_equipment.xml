<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_neumorph_card_sm"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- Top row: emoji + info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvEquipEmoji"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:textSize="24sp"
            android:background="@drawable/bg_neumorph_circle"
            android:text="🏀" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvEquipName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Basketball"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEquipCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ball Sports"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvEquipAvail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 available"
                android:textColor="@color/accent_green"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quantity + Borrow row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp">

        <!-- Qty selector -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_neumorph_card_sm"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnQtyMinus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="−"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue" />

            <TextView
                android:id="@+id/tvQty"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/btnQtyPlus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="+"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Borrow button -->
        <TextView
            android:id="@+id/btnBorrow"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Borrow"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_accent"
            android:paddingHorizontal="24dp"
            android:background="@drawable/bg_pill_active" />

    </LinearLayout>

</LinearLayout>
