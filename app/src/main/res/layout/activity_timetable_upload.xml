<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/neumorph_bg"
    android:padding="24dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Upload Timetable"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvDeptInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Loading your department..."
        android:textColor="@color/accent_blue"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- Image Preview -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_neumorph_card"
        android:layout_marginBottom="20dp">

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:contentDescription="Timetable Preview" />

        <TextView
            android:id="@+id/tvPlaceholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No image selected\nTap 'Pick Image' below"
            android:gravity="center"
            android:textColor="@color/text_muted"
            android:textSize="15sp" />
    </FrameLayout>

    <!-- Status Text -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select your timetable image to get started."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="false"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPickImage"
            style="@style/ProCollegia.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Pick Image"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSave"
            style="@style/ProCollegia.Button.Solid"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Deploy to Students"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
